# Public site origin. Used for Open Graph links.
NEXT_PUBLIC_SITE_URL=http://localhost:43123

# Persistent SQLite directory. Docker uses /data.
DATA_DIR=./data

# Required for GET /api/admin/waitlist. Send as Authorization: Bearer <token>.
ADMIN_TOKEN=replace-with-a-long-random-string

# Optional live fuel prices. Without it, stations are real and prices are estimates.
GOOGLE_MAPS_API_KEY=

# Optional live flights. Amadeus is tried first, then Kiwi.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
KIWI_API_KEY=

# Optional Booking.com affiliate id appended to hotel links. It does not create live rates by itself.
BOOKING_AFFILIATE_ID=

# Optional Ask LifeSaver model. If neither is set, chat stays in labeled demo mode.
OPENAI_API_KEY=
XAI_API_KEY=

# Optional. Jason's Fetch referral code, shown on /receipts. Leave empty until he sends it.
NEXT_PUBLIC_FETCH_REFERRAL_CODE=
